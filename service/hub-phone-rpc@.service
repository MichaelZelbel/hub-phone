[Unit]
Description=hub-phone RPC (one connection)

[Service]
Type=simple
EnvironmentFile=/etc/hub-phone/config.env
ExecStart=/usr/bin/python3 -I /opt/hub-phone/service.py
StandardInput=socket
StandardOutput=socket
# Never the socket: the reply is exactly one JSON object on stdout, and a Python warning
# sharing that stream would corrupt the reply the caller parses.
StandardError=journal
UMask=0077
NoNewPrivileges=true
